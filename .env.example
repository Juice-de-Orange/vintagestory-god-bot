# Copy to .env. Values below are placeholders.

# ── Vintage Story server ──────────────────────────────────────────────────────
# RCON comes from the VintageRCon server mod; its port and password are set there.
RCON_HOST=localhost
RCON_PORT=42425
RCON_PASSWORD=change-me
# Host directory with server-chat.log and server-main.log (mounted read-only). Required:
# compose refuses to start while this is empty. Example: /srv/vintagestory/data/Logs
VS_LOGS_DIR=

# ── Language model (any OpenAI-compatible endpoint) ───────────────────────────
LOCAL_API_BASE_URL=http://localhost:8080/api/v1
# Leave empty if the server needs no key.
LOCAL_API_KEY=change-me
LOCAL_MODEL=gemma4:e4b

# ── The deity ─────────────────────────────────────────────────────────────────
# de = the original German voice, en = English
GODBOT_LANGUAGE=de
GODBOT_DEITY_NAME=Arathos
GOD_KEYWORDS=gott,god,herr,deity,arathos
PROB_RESPOND_ADDRESSED=0.95
PROB_RESPOND_PASSIVE=0.10

# ── What the model may do on your server ─────────────────────────────────────
# Read README "Safety" before adding anything. The default cannot hurt a player.
# Opt-in extras: smite, kill, clearinv, teleport, freeze, kick, gamemode,
# spawn_hostile, tempstorm, month
GODBOT_ALLOWED_ACTIONS=give,giveblock,heal,intoxicate,spawn,weather,time,whisper
GODBOT_ACTIONS_PER_PLAYER=3
GODBOT_ACTIONS_TOTAL=20
GODBOT_ACTION_WINDOW_MIN=10
